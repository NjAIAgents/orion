{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/private/tmp/orion-dev hook breaker",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/private/tmp/orion-dev hook gate",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "/private/tmp/orion-dev hook shield",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "/private/tmp/orion-dev hook breaker",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/private/tmp/orion-dev hook session-start",
            "type": "command"
          }
        ]
      }
    ]
  }
}
