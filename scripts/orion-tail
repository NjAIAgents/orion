#!/usr/bin/env python3
"""Follow the live agent transcript for a running Orion job.

A stopgap, and worth naming as one. Orion's own run log is produced by
`claude -p --output-format json`, which emits a single object AT EXIT -- so
the log is zero bytes for the entire run and there is nothing to tail. A
working run and a hung one look identical from the outside, which is the
actual problem this solves.

The CLI does keep a transcript of its own, appended as it works, under
~/.claude/projects/<mangled-cwd>/<session>.jsonl. That is what this reads.
The real fix is stream-json in the supervisor, which makes Orion's own event
log live; this stays useful afterwards for watching a run in full detail
without turning the event log into a firehose.

Usage:
    orion-tail             follow the most recently active Orion worktree
    orion-tail FCIA-6      follow one ticket's worktree
    orion-tail --once      print the history so far and exit
"""
import json
import os
import sys
import time
from pathlib import Path

PROJECTS = Path.home() / ".claude" / "projects"

# The CLI encodes the working directory into the directory name, replacing
# each separator with a dash: /Users/x/.orion/projects/w/worktrees/orion-k
# becomes -Users-x--orion-projects-w-worktrees-orion-k. Matching on that is
# what separates Orion's sessions from the user's own without opening a file.
MARKER = "-worktrees-"


def transcripts(key=None):
    """Orion worktree session files, newest first."""
    if not PROJECTS.is_dir():
        return []
    want = MARKER
    if key:
        want = MARKER + "orion-" + key.lower()
    out = []
    for d in PROJECTS.iterdir():
        if d.is_dir() and want in d.name:
            out += list(d.glob("*.jsonl"))
    return sorted(out, key=lambda p: p.stat().st_mtime, reverse=True)


def render(line):
    """One transcript line -> zero or more display rows."""
    try:
        m = json.loads(line)
    except Exception:
        return []
    ts = m.get("timestamp", "")[11:19]
    content = (m.get("message") or {}).get("content")
    if not isinstance(content, list):
        return []

    rows = []
    for b in content:
        kind = b.get("type")
        if kind == "tool_use":
            i = b.get("input") or {}
            detail = (
                i.get("file_path")
                or i.get("command")
                or i.get("pattern")
                or i.get("description")
                or ""
            )
            detail = " ".join(str(detail).split())
            if detail.startswith("/"):
                detail = os.path.basename(detail)
            rows.append("  %s  %-6s %s" % (ts, b.get("name", "?"), detail[:100]))
        elif kind == "text" and b.get("text", "").strip():
            # First line only. The full prose is in the transcript; what is
            # wanted here is enough to see whether the agent is on track.
            first = b["text"].strip().split("\n")[0]
            rows.append("  %s  %-6s %s" % (ts, "say", first[:100]))
    return rows


def main():
    once = "--once" in sys.argv
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    key = args[0] if args else None

    files = transcripts(key)
    if not files:
        sys.exit("no Orion agent transcript found; is a job running?")
    path = files[0]
    print("following %s\n" % path.name)

    with path.open() as fh:
        for line in fh:
            for r in render(line):
                print(r)
        if once:
            return
        # Poll rather than watch: another process appends to this file, and
        # a late line costs nothing, whereas a filesystem-watch dependency
        # would make a debugging aid require an install.
        try:
            while True:
                where = fh.tell()
                line = fh.readline()
                if not line:
                    time.sleep(0.5)
                    fh.seek(where)
                    continue
                for r in render(line):
                    print(r, flush=True)
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
